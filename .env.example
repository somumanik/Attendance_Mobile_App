HR_USERNAME=HR001
HR_PASSWORD=Admin@123
JWT_SECRET=change-this-to-a-long-random-secret
DEV_EMPLOYEE_AUTH_ENABLED=false
DEV_EMPLOYEE_PAYCODE=EMP001
DEV_EMPLOYEE_PASSWORD=change-this-development-password
DB_SERVER=
DB_PORT=1433
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true
API_PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# ---------------------------------------------------------------------------
# SuperAdmin (separate MANAGEMENT role - does NOT affect HR/Employee login)
# The password is NEVER configured in plaintext. Generate the hash/salt once:
#   node server/generate-superadmin-hash.js "<your-password>"
# then paste the three values below. If these are not set, SuperAdmin login
# fails closed (503) and no default account exists.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_PASSWORD_SALT=
SUPERADMIN_PASSWORD_ALGO=scrypt-v1



# Brevo (free plan: 300 emails/day) — fallback only. Preferred: save the key in
# HR → Email Configuration → Provider Config (stored encrypted in HR_EmailConfig).
BREVO_API_KEY=
# SMTP fallback (smtp.gmail.com / smtp.office365.com etc). Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Encryption key for provider credentials saved in HR_EmailConfig.
# Auto-generated into .env on first use; keep it stable or re-enter saved credentials.
EMAIL_CRED_KEY=
# Optional table-name overrides
HR_EMAIL_CONFIG_TABLE=dbo.HR_EmailConfig
HR_EMPLOYEE_EMAIL_TABLE=dbo.HR_EmployeeEmails
HR_EMAIL_LOG_TABLE=dbo.HR_EmailLog

# ---------------------------------------------------------------------------
# WhatsApp Attendance Messaging (V1) — server-only. Real sending stays OFF by
# default. Add these to server/.env manually (never commit secrets).
# FREE_MANUAL = preview/export only (no send); CLOUD_API = Meta Graph API.
WHATSAPP_MODE=FREE_MANUAL
WHATSAPP_ENABLED=false
WHATSAPP_SEND_TIME=21:00
WHATSAPP_TIMEZONE=Asia/Kolkata
WHATSAPP_ELIGIBLE_CATEGORY=
WHATSAPP_DRY_RUN=true
# Cloud API only (or save encrypted via HR -> WhatsApp -> Provider Config):
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional: stable AES key for provider secrets at rest (else JWT_SECRET-derived).
WHATSAPP_CRED_KEY=
# Optional table-name overrides
HR_WHATSAPP_CONFIG_TABLE=dbo.HR_WhatsAppConfig
HR_WHATSAPP_EMPLOYEE_TABLE=dbo.HR_EmployeeWhatsApp
HR_WHATSAPP_LOG_TABLE=dbo.HR_WhatsAppLog
HR_WHATSAPP_JOBRUN_TABLE=dbo.HR_WhatsAppJobRun